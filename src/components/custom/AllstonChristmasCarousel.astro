---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// 1. Fetch all image metadata from the folder automatically
const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/aceing-allston-christmas/*.{jpeg,jpg,png,webp}',
  { eager: true }
);

// 2. Extract the images and sort them alphabetically by their file path
const slides = Object.values(imageFiles)
  .map((file) => file.default)
  .sort((a, b) => a.src.localeCompare(b.src));
---

<div class="relative w-full max-w-4xl mx-auto group">
  <!-- Scroll Snap Container -->
  <div id="carousel-container" class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar gap-4 pb-4">
    {
      slides.map((slide, index) => (
        <div class="snap-center shrink-0 w-full flex justify-center">
          <Image
            src={slide}
            alt={`Guide Page ${index + 1}`}
            class="w-full h-auto object-contain rounded-lg shadow-md border border-gray-200"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))
    }
  </div>

  <!-- Previous Button -->
  <button
    id="prev-btn"
    class="absolute left-4 top-[calc(50%-0.5rem)] -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 p-3 rounded-full shadow-lg transition-all opacity-0 group-hover:opacity-100 disabled:opacity-0 disabled:cursor-not-allowed"
    aria-label="Previous page"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2.5"
      stroke="currentColor"
      class="w-6 h-6"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"></path>
    </svg>
  </button>

  <!-- Next Button -->
  <button
    id="next-btn"
    class="absolute right-4 top-[calc(50%-0.5rem)] -translate-y-1/2 bg-white/90 hover:bg-white text-gray-800 p-3 rounded-full shadow-lg transition-all opacity-0 group-hover:opacity-100 disabled:opacity-0 disabled:cursor-not-allowed"
    aria-label="Next page"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2.5"
      stroke="currentColor"
      class="w-6 h-6"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
    </svg>
  </button>
</div>
<div class="max-w-4xl mx-auto mt-8 p-6 bg-blue-50 rounded-lg shadow-sm border border-blue-100 mb-12">
  <h3 class="text-2xl font-bold text-slate-800 mb-6 border-b border-blue-200 pb-2">Allston Christmas Resources</h3>

  <div class="grid md:grid-cols-2 gap-8">
    <!-- Disposal & Recycling -->
    <div>
