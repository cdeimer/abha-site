            target="_blank"
            class="text-blue-600 hover:text-blue-800 underline break-words">City Guidelines</a
          >
        </li>
      </ul>
    </div>

    <!-- Organizations & Platforms -->
    <div>
      <h4 class="text-lg font-bold text-slate-700 mb-3 flex items-center gap-2">Sell, Give Away & Donate</h4>
      <ul class="list-disc pl-5 space-y-1 text-sm text-slate-700">
        <li>
          <a
            href="https://www.facebook.com/groups/1550115971925250/"
            target="_blank"
            class="text-blue-600 hover:text-blue-800 underline break-words"
            >Everything Free Allston-Brighton Facebook group</a
          >
        </li>
        <li>
          <a
            href="https://www.facebook.com/marketplace/"
            target="_blank"
            class="text-blue-600 hover:text-blue-800 underline break-words">Facebook Marketplace</a
          >
        </li>
        <li>
          <a
            href="https://www.craigslist.org/area/boston"
            target="_blank"
            class="text-blue-600 hover:text-blue-800 underline break-words">Craigslist</a
          >
        </li>
        <li>
          <a
            href="https://www.goodwillmass.org/"
            target="_blank"
            class="text-blue-600 hover:text-blue-800 underline break-words">Goodwill</a
          >
        </li>
        <li>
          <a
            href="https://www.emassbigs.org/"
            target="_blank"
            class="text-blue-600 hover:text-blue-800 underline break-words">Big Brother Big Sister</a
          >
        </li>
        <li>
          <a
            href="https://www.cradlestocrayons.org/boston/"
            target="_blank"
            class="text-blue-600 hover:text-blue-800 underline break-words">Cradles to Crayons</a
          >
        </li>
        <li>
          <a
            href="https://littlefreelibrary.org/map/"
            target="_blank"
            class="text-blue-600 hover:text-blue-800 underline break-words">Little Free Libraries</a
