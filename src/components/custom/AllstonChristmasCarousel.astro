            target="_blank"
            class="text-blue-600 hover:text-blue-800 underline break-words">Arrange for Disposal</a
          >
        </li>
        <li>
          <a
            href="https://www.boston.gov/departments/public-works/recycling-clothing-and-textiles"
            target="_blank"
            class="text-blue-600 hover:text-blue-800 underline break-words">Textile Donation</a
          >
        </li>
      </ul>
    </div>

    <!-- Tenant Rights -->
    <div>
      <h4 class="text-lg font-bold text-slate-700 mb-3 flex items-center gap-2">Tenant Rights Info</h4>
      <ul class="space-y-3 text-sm">
        <li>
          <a
