      <ul class="space-y-3 text-sm">
        <li>
          <a
            href="https://www.boston.gov/departments/public-works/mattress-recycling#/mattress"
            target="_blank"
            class="text-blue-600 hover:text-blue-800 underline break-words">Mattress Disposal Rules</a
          >
        </li>
        <li>
          <a
