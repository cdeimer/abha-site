<script>
  interface BuildingState {
    hasBox: boolean;
    /** Left coordinate in feet from center lot's left edge (0..40) */
    xFt: number;
    /** Top coordinate in feet from rear lot line (0..100) */
    yFt: number;
    /** Building width in feet */
    widthFt: number;
    /** Building depth in feet */
    depthFt: number;
    /** Number of stories (1..4) */
    stories: number;
    /** Number of dwelling units (1..4) */
    units: number;
    /** Roof style: 'flat' (11 ft/story) or 'pitched' (11 ft/story + 6 ft gable peak) */
    roof: 'flat' | 'pitched';
    /** Show setback guides on top-down plan */
    showGuides: boolean;
    /** Add a 20'x20' (400 sq ft) 2-car garage in the rear yard */
    hasGarage: boolean;
  }

  interface RuleResult {
    id: string;
    name: string;
    requirementText: string;
    actualText: string;
    passed: boolean;
    category: 'building' | 'lot';
    detail: string;
  }

  function initZoningVisualizer() {
    const svg = document.querySelector<SVGSVGElement>('#lot-svg');
    if (!svg || svg.dataset.initialized === 'true') return;
    svg.dataset.initialized = 'true';

    // Lot constants (from Allston-Brighton 3F-4000 table in .agents/zoning-visualizer/info.md)
    const LOT_WIDTH_FT = 40;
    const LOT_DEPTH_FT = 100;
    const LOT_AREA_SQFT = LOT_WIDTH_FT * LOT_DEPTH_FT; // 4,000 sq ft
    const NEIGHBOR_DIST_TO_LINE_FT = 4; // Existing triple-deckers are 4 ft from the shared side lot lines

    // SVG Coordinate Constants (1 ft = 5 SVG units)
    const PX_PER_FT = 5;
    const LOT_X0 = 250; // Left edge of center lot in SVG
    const LOT_Y0 = 35; // Rear lot line in SVG

    // Initial state: Empty lot, 1 story / 1 unit, setback limits hidden by default
    const state: BuildingState = {
      hasBox: false,
      xFt: 6,
      yFt: 42,
      widthFt: 28,
      depthFt: 48,
      stories: 1,
      units: 1,
      roof: 'flat',
      showGuides: false,
      hasGarage: false,
    };

    // DOM Elements
    const userBuildingLayer = document.querySelector<SVGGElement>('#user-building-layer')!;
    const userBuildingRect = document.querySelector<SVGRectElement>('#user-building-rect')!;
    const ring2 = document.querySelector<SVGRectElement>('#user-story-ring-2')!;
    const ring3 = document.querySelector<SVGRectElement>('#user-story-ring-3')!;
    const labelBg = document.querySelector<SVGRectElement>('#user-label-bg')!;
    const labelTitle = document.querySelector<SVGTextElement>('#user-label-title')!;
    const labelArea = document.querySelector<SVGTextElement>('#user-label-area')!;
    const labelStories = document.querySelector<SVGTextElement>('#user-label-stories')!;
    const labelFar = document.querySelector<SVGTextElement>('#user-label-far')!;
    const liveDimensionsGroup = document.querySelector<SVGGElement>('#live-dimensions-group')!;
    const resizeHandlesGroup = document.querySelector<SVGGElement>('#resize-handles-group')!;
    const setbackGuidesLayer = document.querySelector<SVGGElement>('#setback-guides-layer')!;
    const garageGroup = document.querySelector<SVGGElement>('#garage-group')!;
    const userElevationGroup = document.querySelector<SVGGElement>('#user-elevation-group')!;
    const elevationSummary = document.getElementById('elevation-summary') as HTMLElement;

    // Controls
    const btnStoryMinus = document.getElementById('btn-story-minus') as HTMLButtonElement;
    const btnStoryPlus = document.getElementById('btn-story-plus') as HTMLButtonElement;
    const storyQuickBtns = document.querySelectorAll<HTMLButtonElement>('.story-quick-btn');
    const selectUnits = document.getElementById('select-units') as HTMLSelectElement;
    const selectRoof = document.getElementById('select-roof') as HTMLSelectElement;
    const toggleGuides = document.getElementById('toggle-setback-guides') as HTMLInputElement;
    const toggleGarage = document.getElementById('toggle-garage') as HTMLInputElement;

    // Action Buttons
    const presetNeighbor = document.getElementById('preset-neighbor') as HTMLButtonElement;
    const presetClear = document.getElementById('preset-clear') as HTMLButtonElement;

    // Metrics & Rules List
    const footprintBadge = document.getElementById('footprint-badge') as HTMLElement;
    const storiesDisplay = document.getElementById('stories-display') as HTMLElement;
    const metricUnitArea = document.getElementById('metric-unit-area') as HTMLElement;
    const metricUnitNote = document.getElementById('metric-unit-note') as HTMLElement;
    const metricTotalArea = document.getElementById('metric-total-area') as HTMLElement;
    const metricFarNote = document.getElementById('metric-far-note') as HTMLElement;
    const metricOpenSpace = document.getElementById('metric-open-space') as HTMLElement;
    const metricOpenNote = document.getElementById('metric-open-note') as HTMLElement;
    const compliancePill = document.getElementById('compliance-pill') as HTMLElement;
    const rulesList = document.getElementById('rules-list') as HTMLElement;

    function getBuildingHeightFt(): number {
      if (!state.hasBox) return 0;
      const baseHeight = state.stories * 11;
      return state.roof === 'pitched' ? baseHeight + 6 : baseHeight;
    }

    function evaluateZoningRules(): RuleResult[] {
      const footprintSqFt = state.hasBox ? state.widthFt * state.depthFt : 0;
      const totalFloorAreaSqFt = footprintSqFt * state.stories;
      const far = totalFloorAreaSqFt / LOT_AREA_SQFT;
      const heightFt = getBuildingHeightFt();

      const frontYardFt = state.hasBox ? LOT_DEPTH_FT - (state.yFt + state.depthFt) : LOT_DEPTH_FT;
      const rearYardFt = state.hasBox ? state.yFt : LOT_DEPTH_FT;
      const leftSideFt = state.hasBox ? state.xFt : LOT_WIDTH_FT;
      const rightSideFt = state.hasBox ? LOT_WIDTH_FT - (state.xFt + state.widthFt) : LOT_WIDTH_FT;
      const aggregateSideFt = leftSideFt + rightSideFt;
      const distLeftNeighborFt = leftSideFt + NEIGHBOR_DIST_TO_LINE_FT;
      const distRightNeighborFt = rightSideFt + NEIGHBOR_DIST_TO_LINE_FT;

      // Required Lot Area: 4,000 sq ft for 1 or 2 units, +2,000 sq ft for each additional unit
      // 1 or 2 units -> 4,000; 3 units -> 6,000; 4 units -> 8,000
      const requiredLotAreaSqFt = state.units <= 2 ? 4000 : 4000 + (state.units - 2) * 2000;

      // Usable Open Space: 650 sq ft per dwelling unit
      // Per Boston Zoning Code, Usable Open Space excludes the building footprint, required front yard (20' x 40' = 800 sq ft), and accessory buildings
      const requiredFrontYardArea = LOT_WIDTH_FT * 20; // 800 sq ft
      const garageArea = state.hasGarage ? 400 : 0;
      const footprintBehindFrontYard = state.hasBox
        ? state.widthFt * Math.max(0, Math.min(state.yFt + state.depthFt, LOT_DEPTH_FT - 20) - state.yFt)
        : 0;
      const usableOpenSpaceSqFt = Math.max(
        0,
        LOT_AREA_SQFT - requiredFrontYardArea - footprintBehindFrontYard - garageArea
      );
      const requiredOpenSpaceSqFt = state.units * 650;

      // Rear Yard Occupancy by Accessory Buildings (Max 25%)
      // Required Rear Yard is 30' deep x 40' wide = 1,200 sq ft
      const rearYardAreaSqFt = LOT_WIDTH_FT * 30; // 1,200 sq ft
      const rearYardAccessoryPercent = Math.round((garageArea / rearYardAreaSqFt) * 100);

      // Side yard check: >= 5' from side lot line, >= 10' from abutting structure, >= 15' aggregate
      const sideMinLinePass = !state.hasBox || (leftSideFt >= 5 && rightSideFt >= 5);
      const sideNeighborPass = !state.hasBox || (distLeftNeighborFt >= 10 && distRightNeighborFt >= 10);
      const sideAggregatePass = !state.hasBox || aggregateSideFt >= 15;
      const sideYardPass = sideMinLinePass && sideNeighborPass && sideAggregatePass;

      return [
        {
          id: 'front-yard',
          name: 'Front Yard Minimum Depth',
          requirementText: 'Min 20 ft',
          actualText: state.hasBox ? `${frontYardFt} ft` : '—',
          passed: !state.hasBox || frontYardFt >= 20,
          category: 'building',
          detail:
            !state.hasBox || frontYardFt >= 20
              ? 'Compliant with 20 ft minimum front yard setback (neighbors are at 10 ft).'
              : `Violates 20 ft minimum front setback by ${20 - frontYardFt} ft (even though 1910 neighbors sit at 10 ft!).`,
        },
        {
          id: 'side-yard',
          name: 'Side Yard Minimum Width',
          requirementText: '≥5′ line, ≥10′ neighbor, ≥15′ total',
          actualText: state.hasBox
            ? `L: ${leftSideFt}′ (${distLeftNeighborFt}′ nbr) | R: ${rightSideFt}′ (${distRightNeighborFt}′ nbr) | Sum: ${aggregateSideFt}′`
            : '—',
          passed: sideYardPass,
          category: 'building',
          detail: sideYardPass
            ? 'Meets 5 ft lot line, 10 ft abutting building separation, and 15 ft aggregate width.'
            : !sideMinLinePass
              ? `Too close to side lot line (min 5 ft required; currently ${Math.min(leftSideFt, rightSideFt)} ft).`
              : !sideNeighborPass
                ? `Within 10 ft of an existing triple-decker on an abutting lot (currently ${Math.min(distLeftNeighborFt, distRightNeighborFt)} ft away).`
                : `Combined side yards (${aggregateSideFt} ft) are less than the required 15 ft aggregate minimum.`,
        },
        {
          id: 'rear-yard',
          name: 'Rear Yard Minimum Depth',
          requirementText: 'Min 30 ft',
          actualText: state.hasBox ? `${rearYardFt} ft` : '—',
          passed: !state.hasBox || rearYardFt >= 30,
          category: 'building',
          detail:
            !state.hasBox || rearYardFt >= 30
              ? 'Meets the 30 ft minimum rear yard depth.'
              : `Building extends ${30 - rearYardFt} ft into the mandatory 30 ft rear yard setback.`,
        },
        {
          id: 'far',
          name: 'Floor Area Ratio (FAR) Maximum',
          requirementText: 'Max 0.80 (3,200 sf)',
          actualText: state.hasBox ? `${far.toFixed(2)} (${totalFloorAreaSqFt.toLocaleString()} sf)` : '0.00 (0 sf)',
          passed: !state.hasBox || far <= 0.8 + 1e-6,
          category: 'building',
          detail:
            !state.hasBox || far <= 0.8 + 1e-6
              ? `Total floor area (${totalFloorAreaSqFt.toLocaleString()} sq. ft.) is within 0.80 × 4,000 = 3,200 sq. ft.`
              : `Exceeds 0.80 FAR cap by ${(totalFloorAreaSqFt - 3200).toLocaleString()} sq. ft. (Neighbors are 1.01 FAR!).`,
        },
        {
          id: 'height-stories',
          name: 'Building Height Maximum (Stories)',
          requirementText: 'Max 3 Stories',
          actualText: state.hasBox ? `${state.stories} ${state.stories === 1 ? 'Story' : 'Stories'}` : '—',
          passed: !state.hasBox || state.stories <= 3,
          category: 'building',
          detail:
            !state.hasBox || state.stories <= 3
              ? 'Within the 3-story maximum height limit.'
              : 'Exceeds the 3-story maximum height limit in a 3F-4000 subdistrict.',
        },
        {
          id: 'height-feet',
          name: 'Building Height Maximum (Feet)',
          requirementText: 'Max 35 ft',
          actualText: state.hasBox ? `${heightFt} ft` : '—',
          passed: !state.hasBox || heightFt <= 35,
          category: 'building',
          detail:
            !state.hasBox || heightFt <= 35
              ? `Total height (${heightFt} ft) is under the 35 ft ceiling.`
              : `At ${heightFt} ft, the roof exceeds the 35 ft height limit by ${heightFt - 35} ft!`,
        },
        {
          id: 'open-space',
          name: 'Usable Open Space Minimum',
          requirementText: `650 sf/unit (${requiredOpenSpaceSqFt.toLocaleString()} sf)`,
          actualText: `${usableOpenSpaceSqFt.toLocaleString()} sf (${Math.round(usableOpenSpaceSqFt / state.units)} sf/u)`,
          passed: usableOpenSpaceSqFt >= requiredOpenSpaceSqFt,
          category: 'building',
          detail:
            usableOpenSpaceSqFt >= requiredOpenSpaceSqFt
              ? `Provides ${usableOpenSpaceSqFt.toLocaleString()} sq. ft. of usable open space outside the front yard.`
              : `Short by ${(requiredOpenSpaceSqFt - usableOpenSpaceSqFt).toLocaleString()} sq. ft. (Front yard setback cannot count as usable open space).`,
        },
        {
          id: 'rear-occupancy',
          name: 'Rear Yard Max Accessory Occupancy',
          requirementText: 'Max 25%',
          actualText: `${rearYardAccessoryPercent}% (${garageArea} sf)`,
          passed: rearYardAccessoryPercent <= 25,
          category: 'building',
          detail:
            rearYardAccessoryPercent <= 25
              ? 'Accessory structures occupy ≤ 25% of the required rear yard.'
              : 'A standard 20′×20′ 2-car garage (400 sq. ft.) takes up 33% of the 1,200 sq. ft. rear yard (max 25%)!',
        },
        {
          id: 'lot-area',
          name: 'Minimum Lot Area (Base + Per Add’l Unit)',
          requirementText: `${requiredLotAreaSqFt.toLocaleString()} sf (${state.units} ${state.units === 1 ? 'unit' : 'units'})`,
          actualText: `${LOT_AREA_SQFT.toLocaleString()} sf`,
          passed: LOT_AREA_SQFT >= requiredLotAreaSqFt,
          category: 'lot',
          detail:
            LOT_AREA_SQFT >= requiredLotAreaSqFt
              ? `4,000 sq. ft. meets the minimum lot area for ${state.units} ${state.units === 1 ? 'unit' : 'units'} (4,000 sq. ft. base for 1–2 units).`
              : `4,000 sq. ft. only permits 1–2 units! ${state.units} units require ${requiredLotAreaSqFt.toLocaleString()} sq. ft. (4,000 base + 2,000 per unit above 2).`,
        },
      ];
    }

    function renderDimensionArrows() {
      if (!state.hasBox) {
        liveDimensionsGroup.innerHTML = '';
        return;
      }

      const xPx = LOT_X0 + state.xFt * PX_PER_FT;
      const yPx = LOT_Y0 + state.yFt * PX_PER_FT;
      const wPx = state.widthFt * PX_PER_FT;
      const hPx = state.depthFt * PX_PER_FT;

      const frontYardFt = LOT_DEPTH_FT - (state.yFt + state.depthFt);
      const rearYardFt = state.yFt;
      const leftSideFt = state.xFt;
      const rightSideFt = LOT_WIDTH_FT - (state.xFt + state.widthFt);
      const aggregateSideFt = leftSideFt + rightSideFt;
      const distLeftNeighborFt = leftSideFt + NEIGHBOR_DIST_TO_LINE_FT;
      const distRightNeighborFt = rightSideFt + NEIGHBOR_DIST_TO_LINE_FT;

      const frontOk = frontYardFt >= 20;
      const rearOk = rearYardFt >= 30;
      const leftOk = leftSideFt >= 5 && distLeftNeighborFt >= 10 && aggregateSideFt >= 15;
      const rightOk = rightSideFt >= 5 && distRightNeighborFt >= 10 && aggregateSideFt >= 15;

      const frontColor = frontOk ? '#059669' : '#dc2626';
      const rearColor = rearOk ? '#059669' : '#dc2626';
      const leftColor = leftOk ? '#059669' : '#dc2626';
      const rightColor = rightOk ? '#059669' : '#dc2626';

      const midX = xPx + wPx / 2;
      const midY = yPx + hPx / 2;

      liveDimensionsGroup.innerHTML = `
        <!-- Rear Yard Dimension Line -->
        <line x1="${midX}" y1="${LOT_Y0}" x2="${midX}" y2="${yPx}" stroke="${rearColor}" stroke-width="2" stroke-dasharray="3 2" />
        <rect x="${midX - 42}" y="${(LOT_Y0 + yPx) / 2 - 9}" width="84" height="17" rx="4" fill="${rearColor}" />
        <text x="${midX}" y="${(LOT_Y0 + yPx) / 2 + 3}" text-anchor="middle" fill="#ffffff" font-size="9.5" font-weight="bold">
          Rear: ${rearYardFt}′ (min 30′)
        </text>

        <!-- Front Yard Dimension Line -->
        <line x1="${midX}" y1="${yPx + hPx}" x2="${midX}" y2="${LOT_Y0 + 500}" stroke="${frontColor}" stroke-width="2" stroke-dasharray="3 2" />
        <rect x="${midX - 44}" y="${(yPx + hPx + LOT_Y0 + 500) / 2 - 9}" width="88" height="17" rx="4" fill="${frontColor}" />
        <text x="${midX}" y="${(yPx + hPx + LOT_Y0 + 500) / 2 + 3}" text-anchor="middle" fill="#ffffff" font-size="9.5" font-weight="bold">
          Front: ${frontYardFt}′ (min 20′)
        </text>

        <!-- Left Side Yard Dimension -->
        <line x1="${LOT_X0}" y1="${midY - 12}" x2="${xPx}" y2="${midY - 12}" stroke="${leftColor}" stroke-width="2" />
        <rect x="${LOT_X0 + 2}" y="${midY - 32}" width="64" height="16" rx="3" fill="${leftColor}" />
        <text x="${LOT_X0 + 34}" y="${midY - 21}" text-anchor="middle" fill="#ffffff" font-size="9" font-weight="bold">
          L: ${leftSideFt}′ (${distLeftNeighborFt}′ nbr)
        </text>

        <!-- Right Side Yard Dimension -->
        <line x1="${xPx + wPx}" y1="${midY + 12}" x2="${LOT_X0 + 200}" y2="${midY + 12}" stroke="${rightColor}" stroke-width="2" />
        <rect x="${LOT_X0 + 200 - 66}" y="${midY + 16}" width="64" height="16" rx="3" fill="${rightColor}" />
        <text x="${LOT_X0 + 200 - 34}" y="${midY + 27}" text-anchor="middle" fill="#ffffff" font-size="9" font-weight="bold">
          R: ${rightSideFt}′ (${distRightNeighborFt}′ nbr)
        </text>
      `;
    }

    function renderElevation(buildingRulesPassed: boolean) {
      const heightFt = getBuildingHeightFt();
      if (!state.hasBox) {
        userElevationGroup.innerHTML = '';
        elevationSummary.textContent = 'Empty Lot';
        return;
      }

      const xPx = LOT_X0 + state.xFt * PX_PER_FT;
      const wPx = state.widthFt * PX_PER_FT;
      const groundY = 210;
      const pxPerHeightFt = 3.5;
      const bodyHeightFt = state.stories * 11;
      const bodyHeightPx = bodyHeightFt * pxPerHeightFt;
      const bodyTopY = groundY - bodyHeightPx;

      const fillClass = buildingRulesPassed ? '#10b981' : '#ef4444';
      const strokeColor = buildingRulesPassed ? '#047857' : '#991b1b';

      let floorsSvg = '';
      for (let s = 1; s <= state.stories; s++) {
        const floorTopY = groundY - s * 11 * pxPerHeightFt;
        if (s < state.stories) {
          floorsSvg += `<line x1="${xPx}" y1="${floorTopY}" x2="${xPx + wPx}" y2="${floorTopY}" stroke="${strokeColor}" stroke-width="1.5" />`;
        }
        const winY = floorTopY + 8;
        const winH = 18;
        const numWins = Math.max(1, Math.min(4, Math.floor(state.widthFt / 7)));
        const spacing = wPx / (numWins + 1);
        for (let w = 1; w <= numWins; w++) {
          const winX = xPx + w * spacing - 7;
          floorsSvg += `<rect x="${winX}" y="${winY}" width="14" height="${winH}" rx="1.5" fill="#e0f2fe" stroke="${strokeColor}" stroke-width="1" />`;
        }
      }

      let roofSvg = '';
      let topLabelY = bodyTopY - 8;
      if (state.roof === 'pitched') {
        const peakY = bodyTopY - 6 * pxPerHeightFt;
        topLabelY = peakY - 6;
        roofSvg = `<polygon points="${xPx - 3},${bodyTopY} ${xPx + wPx / 2},${peakY} ${xPx + wPx + 3},${bodyTopY}" fill="${strokeColor}" />`;
      } else {
        roofSvg = `<rect x="${xPx - 3}" y="${bodyTopY - 5}" width="${wPx + 6}" height="6" rx="1" fill="${strokeColor}" />`;
      }

      userElevationGroup.innerHTML = `
        <rect x="${xPx}" y="${bodyTopY}" width="${wPx}" height="${bodyHeightPx}" fill="${fillClass}" fill-opacity="0.82" stroke="${strokeColor}" stroke-width="2" />
        ${floorsSvg}
        ${roofSvg}
        <text x="${xPx + wPx / 2}" y="${Math.max(18, topLabelY)}" text-anchor="middle" fill="${strokeColor}" font-size="10.5" font-weight="bold">
          Your Design: ${state.stories} Fl (${heightFt}′)
        </text>
      `;

      elevationSummary.textContent = `${state.stories} ${state.stories === 1 ? 'Story' : 'Stories'} • ${heightFt} ft tall • ${state.units} ${state.units === 1 ? 'Unit' : 'Units'}`;
    }

    function updateUI() {
      // Visibility of guides & garage
      setbackGuidesLayer.classList.toggle('hidden', !state.showGuides);
      garageGroup.classList.toggle('hidden', !state.hasGarage);

      const rules = evaluateZoningRules();
      const failedRules = rules.filter((r) => !r.passed);
      const buildingRules = rules.filter((r) => r.category === 'building');
      const failedBuildingRules = buildingRules.filter((r) => !r.passed);
      const buildingRulesAllPass = state.hasBox && failedBuildingRules.length === 0;

      // Update Top-Down Building Box SVG
      if (!state.hasBox) {
        userBuildingLayer.classList.add('hidden');
      } else {
        userBuildingLayer.classList.remove('hidden');

        const xPx = LOT_X0 + state.xFt * PX_PER_FT;
        const yPx = LOT_Y0 + state.yFt * PX_PER_FT;
        const wPx = state.widthFt * PX_PER_FT;
        const hPx = state.depthFt * PX_PER_FT;

        userBuildingRect.setAttribute('x', String(xPx));
        userBuildingRect.setAttribute('y', String(yPx));
        userBuildingRect.setAttribute('width', String(wPx));
        userBuildingRect.setAttribute('height', String(hPx));

        // Color building box based on whether all rules pass or if any rule fails
        userBuildingRect.setAttribute(
          'class',
          failedRules.length === 0
            ? 'fill-emerald-600/85 stroke-emerald-950 dark:stroke-white cursor-move'
            : buildingRulesAllPass
              ? 'fill-amber-500/85 stroke-amber-950 dark:stroke-white cursor-move'
              : 'fill-rose-600/80 stroke-rose-950 dark:stroke-white cursor-move'
        );

        // Story rings
        if (state.stories >= 2 && wPx > 16 && hPx > 16) {
          ring2.classList.remove('hidden');
          ring2.setAttribute('x', String(xPx + 4));
          ring2.setAttribute('y', String(yPx + 4));
          ring2.setAttribute('width', String(wPx - 8));
          ring2.setAttribute('height', String(hPx - 8));
        } else {
          ring2.classList.add('hidden');
        }

        if (state.stories >= 3 && wPx > 28 && hPx > 28) {
          ring3.classList.remove('hidden');
          ring3.setAttribute('x', String(xPx + 8));
          ring3.setAttribute('y', String(yPx + 8));
          ring3.setAttribute('width', String(wPx - 16));
          ring3.setAttribute('height', String(hPx - 16));
        } else {
          ring3.classList.add('hidden');
        }

        // Center label inside building
        const cx = xPx + wPx / 2;
        const cy = yPx + hPx / 2;
        const footprintSqFt = state.widthFt * state.depthFt;
        const totalSqFt = footprintSqFt * state.stories;
        const far = totalSqFt / LOT_AREA_SQFT;

        labelBg.setAttribute('x', String(cx - 58));
        labelBg.setAttribute('y', String(cy - 34));
        labelTitle.setAttribute('x', String(cx));
        labelTitle.setAttribute('y', String(cy - 17));
        labelTitle.textContent = `${state.widthFt}′ × ${state.depthFt}′`;

        labelArea.setAttribute('x', String(cx));
        labelArea.setAttribute('y', String(cy - 2));
        labelArea.textContent = `${footprintSqFt.toLocaleString()} sq. ft. / fl`;

        labelStories.setAttribute('x', String(cx));
        labelStories.setAttribute('y', String(cy + 13));
        labelStories.textContent = `${state.stories} Fl (${totalSqFt.toLocaleString()} sf)`;

        labelFar.setAttribute('x', String(cx));
        labelFar.setAttribute('y', String(cy + 26));
        labelFar.textContent = `FAR: ${far.toFixed(2)} (Max 0.80)`;

        // Update 8 resize handles
        const setHandlePos = (name: string, hx: number, hy: number) => {
          const el = resizeHandlesGroup.querySelector(`[data-handle="${name}"]`);
          if (!el) return;
          if (el.tagName.toLowerCase() === 'circle') {
            el.setAttribute('cx', String(hx));
            el.setAttribute('cy', String(hy));
          } else {
            el.setAttribute('x', String(hx));
            el.setAttribute('y', String(hy));
          }
        };

        setHandlePos('n', cx - 10, yPx - 5);
        setHandlePos('s', cx - 10, yPx + hPx - 5);
        setHandlePos('w', xPx - 5, cy - 10);
        setHandlePos('e', xPx + wPx - 5, cy - 10);
        setHandlePos('nw', xPx, yPx);
        setHandlePos('ne', xPx + wPx, yPx);
        setHandlePos('sw', xPx, yPx + hPx);
        setHandlePos('se', xPx + wPx, yPx + hPx);
      }

      renderDimensionArrows();
      renderElevation(failedRules.length === 0);

      // Update Controls & Metric Badges
      const footprintSqFt = state.hasBox ? state.widthFt * state.depthFt : 0;
      const totalSqFt = footprintSqFt * state.stories;
      const far = totalSqFt / LOT_AREA_SQFT;

      footprintBadge.textContent = state.hasBox
        ? `${state.widthFt}′ × ${state.depthFt}′ (${footprintSqFt.toLocaleString()} sf)`
        : 'Empty Lot';

      storiesDisplay.textContent =
        state.stories === 3
          ? '3 Stories (Triple-Decker)'
          : state.stories > 3
            ? `${state.stories} Stories (Over Limit!)`
            : `${state.stories} ${state.stories === 1 ? 'Story' : 'Stories'}`;

      storyQuickBtns.forEach((btn) => {
        const s = Number(btn.dataset.setStories);
        if (s === state.stories) {
          btn.className =
            'story-quick-btn col-span-1 py-2 rounded-lg text-xs font-extrabold border bg-indigo-600 text-white border-indigo-600 cursor-pointer';
        } else {
          btn.className =
            'story-quick-btn col-span-1 py-2 rounded-lg text-xs font-bold border bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border-slate-300 dark:border-slate-700 hover:bg-slate-50 cursor-pointer';
        }
      });

      const sqFtPerUnit = state.hasBox ? Math.round(totalSqFt / state.units) : 0;
      metricUnitArea.textContent = state.hasBox ? `${sqFtPerUnit.toLocaleString()} sf` : '0 sf';
      if (!state.hasBox) {
        metricUnitNote.textContent = 'Draw a building';
        metricUnitNote.className = 'text-[10px] text-slate-500 font-semibold';
      } else if (sqFtPerUnit >= 1000) {
        metricUnitNote.textContent = 'Full Family Size';
        metricUnitNote.className = 'text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold';
      } else {
        metricUnitNote.textContent = `${Math.round((sqFtPerUnit / 1344) * 100)}% of Neighbor Size`;
        metricUnitNote.className = 'text-[10px] text-amber-600 dark:text-amber-400 font-semibold';
      }

      metricTotalArea.textContent = `${totalSqFt.toLocaleString()} sf`;
      const farRule = rules.find((r) => r.id === 'far')!;
      metricFarNote.textContent = `FAR ${far.toFixed(2)} (Max 0.80)`;
      metricFarNote.className = farRule.passed
        ? 'text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold'
        : 'text-[10px] text-rose-600 dark:text-rose-400 font-semibold';

      const openRule = rules.find((r) => r.id === 'open-space')!;
      metricOpenSpace.textContent = openRule.actualText.split(' (')[0];
      metricOpenNote.textContent = openRule.passed
        ? `Meets ${state.units * 650} sf min`
        : `Needs ${state.units * 650} sf`;
      metricOpenNote.className = openRule.passed
        ? 'text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold'
        : 'text-[10px] text-rose-600 dark:text-rose-400 font-semibold';

      // Render Zoning Compliance List
      compliancePill.textContent = `${failedRules.length} ${failedRules.length === 1 ? 'Violation' : 'Violations'}`;
      compliancePill.className =
        failedRules.length === 0
          ? 'px-2.5 py-1 rounded-full text-xs font-extrabold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300'
          : 'px-2.5 py-1 rounded-full text-xs font-extrabold bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300';

      rulesList.innerHTML = rules
        .map(
          (rule) => `
        <div class="px-4 py-3 flex items-start justify-between gap-3 ${
          rule.passed ? 'bg-white dark:bg-slate-900' : 'bg-rose-50/70 dark:bg-rose-950/30'
        }">
          <div class="space-y-0.5 pr-2">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center justify-center w-4 h-4 rounded-full text-[10px] font-extrabold ${
                rule.passed
                  ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-200'
                  : 'bg-rose-600 text-white'
              }">
                ${rule.passed ? '✓' : '✕'}
              </span>
              <span class="text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100">
                ${rule.name}
              </span>
            </div>
            <p class="text-[11px] text-slate-600 dark:text-slate-400 pl-6 leading-snug">
              ${rule.detail}
            </p>
          </div>
          <div class="text-right shrink-0">
            <div class="text-xs font-extrabold ${
              rule.passed ? 'text-emerald-700 dark:text-emerald-400' : 'text-rose-700 dark:text-rose-400'
            }">
              ${rule.actualText}
            </div>
            <div class="text-[10px] font-medium text-slate-500 dark:text-slate-400">
              Req: ${rule.requirementText}
            </div>
          </div>
        </div>
      `
        )
        .join('');
    }

    // Pointer Interaction on the SVG Canvas (Drawing, Moving, and Resizing)
    type DragMode = 'none' | 'draw' | 'move' | 'n' | 's' | 'w' | 'e' | 'nw' | 'ne' | 'sw' | 'se';
    let dragMode: DragMode = 'none';
    let startPtFt = { x: 0, y: 0 };
    let initialBox = { xFt: 0, yFt: 0, widthFt: 0, depthFt: 0 };

    function clientToLotFt(clientX: number, clientY: number): { x: number; y: number } {
      const rect = svg!.getBoundingClientRect();
      const svgX = ((clientX - rect.left) / rect.width) * 700;
      const svgY = ((clientY - rect.top) / rect.height) * 615;
      const xFt = Math.round((svgX - LOT_X0) / PX_PER_FT);
      const yFt = Math.round((svgY - LOT_Y0) / PX_PER_FT);
      return {
        x: Math.max(0, Math.min(LOT_WIDTH_FT, xFt)),
        y: Math.max(0, Math.min(LOT_DEPTH_FT, yFt)),
      };
    }

    svg.addEventListener('pointerdown', (e: PointerEvent) => {
      const target = e.target as Element;
      const handleAttr = target.getAttribute('data-handle') as DragMode | null;

      const pt = clientToLotFt(e.clientX, e.clientY);

      if (handleAttr && state.hasBox) {
        dragMode = handleAttr;
      } else if (state.hasBox && target.id === 'user-building-rect') {
        dragMode = 'move';
      } else {
        // Check if click is inside the center lot (X: 250..450, Y: 35..535)
        const rect = svg.getBoundingClientRect();
        const svgX = ((e.clientX - rect.left) / rect.width) * 700;
        const svgY = ((e.clientY - rect.top) / rect.height) * 615;
        if (svgX < LOT_X0 || svgX > LOT_X0 + 200 || svgY < LOT_Y0 || svgY > LOT_Y0 + 500) {
          return;
        }
        dragMode = 'draw';
        state.hasBox = true;
        state.xFt = Math.min(LOT_WIDTH_FT - 4, pt.x);
        state.yFt = Math.min(LOT_DEPTH_FT - 4, pt.y);
        state.widthFt = 4;
        state.depthFt = 4;
      }

      startPtFt = pt;
      initialBox = {
        xFt: state.xFt,
        yFt: state.yFt,
        widthFt: state.widthFt,
        depthFt: state.depthFt,
      };
      svg.setPointerCapture(e.pointerId);
      updateUI();
    });

    svg.addEventListener('pointermove', (e: PointerEvent) => {
      if (dragMode === 'none') return;
      const pt = clientToLotFt(e.clientX, e.clientY);
      const dx = pt.x - startPtFt.x;
      const dy = pt.y - startPtFt.y;
      const MIN_SIZE = 6;

      if (dragMode === 'draw') {
        const x1 = Math.max(0, Math.min(startPtFt.x, pt.x));
        const x2 = Math.min(LOT_WIDTH_FT, Math.max(startPtFt.x, pt.x));
        const y1 = Math.max(0, Math.min(startPtFt.y, pt.y));
        const y2 = Math.min(LOT_DEPTH_FT, Math.max(startPtFt.y, pt.y));
        state.xFt = x1;
        state.yFt = y1;
        state.widthFt = Math.max(MIN_SIZE, Math.min(LOT_WIDTH_FT - x1, x2 - x1));
        state.depthFt = Math.max(MIN_SIZE, Math.min(LOT_DEPTH_FT - y1, y2 - y1));
      } else if (dragMode === 'move') {
        state.xFt = Math.max(0, Math.min(LOT_WIDTH_FT - initialBox.widthFt, initialBox.xFt + dx));
        state.yFt = Math.max(0, Math.min(LOT_DEPTH_FT - initialBox.depthFt, initialBox.yFt + dy));
      } else {
        let left = initialBox.xFt;
        let right = initialBox.xFt + initialBox.widthFt;
        let top = initialBox.yFt;
        let bottom = initialBox.yFt + initialBox.depthFt;

        if (dragMode.includes('w')) {
          left = Math.max(0, Math.min(right - MIN_SIZE, initialBox.xFt + dx));
        }
        if (dragMode.includes('e')) {
          right = Math.min(LOT_WIDTH_FT, Math.max(left + MIN_SIZE, initialBox.xFt + initialBox.widthFt + dx));
        }
        if (dragMode.includes('n')) {
          top = Math.max(0, Math.min(bottom - MIN_SIZE, initialBox.yFt + dy));
        }
        if (dragMode.includes('s')) {
          bottom = Math.min(LOT_DEPTH_FT, Math.max(top + MIN_SIZE, initialBox.yFt + initialBox.depthFt + dy));
        }

        state.xFt = left;
        state.yFt = top;
        state.widthFt = right - left;
        state.depthFt = bottom - top;
      }

      updateUI();
    });

    const endDrag = (e: PointerEvent) => {
      if (dragMode !== 'none') {
        dragMode = 'none';
        if (svg.hasPointerCapture(e.pointerId)) {
          svg.releasePointerCapture(e.pointerId);
        }
      }
    };

    svg.addEventListener('pointerup', endDrag);
    svg.addEventListener('pointercancel', endDrag);

    // Control Event Listeners
    btnStoryMinus.addEventListener('click', () => {
      state.stories = Math.max(1, state.stories - 1);
      state.units = state.stories;
      selectUnits.value = String(state.units);
      updateUI();
    });

    btnStoryPlus.addEventListener('click', () => {
      state.stories = Math.min(4, state.stories + 1);
      state.units = state.stories;
      selectUnits.value = String(state.units);
      updateUI();
    });

    storyQuickBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        state.stories = Number(btn.dataset.setStories) || 1;
        state.units = state.stories;
        selectUnits.value = String(state.units);
        updateUI();
      });
    });

    selectUnits.addEventListener('change', () => {
      state.units = Number(selectUnits.value) || 1;
      updateUI();
    });

    selectRoof.addEventListener('change', () => {
      state.roof = selectRoof.value === 'pitched' ? 'pitched' : 'flat';
      updateUI();
    });

    toggleGuides.addEventListener('change', () => {
      state.showGuides = toggleGuides.checked;
      updateUI();
    });

    toggleGarage.addEventListener('change', () => {
      state.hasGarage = toggleGarage.checked;
      updateUI();
    });

    // Presets
    presetNeighbor.addEventListener('click', () => {
      state.hasBox = true;
      state.xFt = 6;
      state.yFt = 42;
      state.widthFt = 28;
      state.depthFt = 48;
      state.stories = 3;
      state.units = 3;
      state.roof = 'flat';
      selectUnits.value = '3';
      selectRoof.value = 'flat';
      updateUI();
    });

    presetClear.addEventListener('click', () => {
      state.hasBox = false;
      state.stories = 1;
      state.units = 1;
      selectUnits.value = '1';
      updateUI();
    });

    updateUI();
  }

  // Initialize on both standard load and Astro View Transitions navigation
  initZoningVisualizer();
  document.addEventListener('astro:page-load', initZoningVisualizer);
</script>
