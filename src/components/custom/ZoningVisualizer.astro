---
import { Icon } from 'astro-icon/components';
---

<section class="relative py-8 md:py-12 max-w-7xl mx-auto px-4 sm:px-6">
  <!-- Intro Header -->
  <div class="max-w-4xl mx-auto text-center mb-8">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-heading mb-4">
      Can You Build a Legal <span class="text-accent dark:text-purple-400">Triple-Decker</span>?
    </h1>
    <p class="text-base sm:text-lg text-muted max-w-3xl mx-auto leading-relaxed">
      You own an empty <strong>40&prime; &times; 100&prime; (4,000 sq. ft.)</strong> residential lot in Allston-Brighton&rsquo;s
      <strong>Three-Family Residential (<code class="font-mono text-sm">3F-4000</code>)</strong> zoning subdistrict, flanked
      by two classic Boston triple-deckers built around 1910 (before zoning existed). Draw a building box in the empty lot
      and add stories to see if you can build a 3-family home without violating a zoning rule.
    </p>
  </div>

  <!-- Main Workspace Grid: Left = Lot Drawing Canvas & 3D Elevation, Right = Controls & Live Zoning Table -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Left Column: Interactive Lot Plan + Streetscape Elevation (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Top Card: Interactive Top-Down Site Plan -->
      <div
        class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-md overflow-hidden"
      >
        <div
          class="px-4 py-3 border-b border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 bg-slate-50 dark:bg-slate-800/60"
        >
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <h3 class="font-bold text-sm sm:text-base text-slate-800 dark:text-slate-100">
              Interactive Lot Plan (Top-Down View)
            </h3>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <label
              class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 cursor-pointer select-none"
            >
              <input
                type="checkbox"
                id="toggle-setback-guides"
                class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
              />
              <span>Show Setback Limits</span>
            </label>
            <label
              class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 cursor-pointer select-none"
            >
              <input
                type="checkbox"
                id="toggle-garage"
                class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
              />
              <span>Add 2-Car Rear Garage</span>
            </label>
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                id="preset-neighbor"
                class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-amber-600 hover:bg-amber-700 text-white shadow-sm transition cursor-pointer"
              >
                Copy Neighbor
              </button>
              <button
                type="button"
                id="preset-clear"
                class="px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-800 dark:text-slate-200 transition cursor-pointer"
              >
                Clear Lot
              </button>
            </div>
          </div>
        </div>

        <div class="p-3 sm:p-4 bg-slate-100/70 dark:bg-slate-950/60">
          <div class="relative w-full select-none">
            <svg
              id="lot-svg"
              viewBox="0 0 700 615"
              class="w-full h-auto rounded-xl border border-slate-300 dark:border-slate-700 bg-[#e8f0e6] dark:bg-[#132019] shadow-inner touch-none"
              aria-label="Interactive zoning lot map showing three 40 by 100 foot lots"
            >
              <defs>
                <!-- Subtle 5-foot grid pattern (25x25 units) -->
                <pattern id="lot-grid" width="25" height="25" patternUnits="userSpaceOnUse" x="50" y="35">
                  <path
                    d="M 25 0 L 0 0 0 25"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="0.6"
                    class="text-emerald-900/15 dark:text-emerald-200/10"></path>
                </pattern>
                <!-- Hatch pattern for non-buildable setback zone -->
                <pattern
                  id="setback-hatch"
                  width="12"
                  height="12"
                  patternTransform="rotate(45 0 0)"
                  patternUnits="userSpaceOnUse"
                >
                  <line x1="0" y1="0" x2="0" y2="12" stroke="#ef4444" stroke-width="2" stroke-opacity="0.22"></line>
                </pattern>
                <!-- Shingle roof texture for neighbor triple-deckers -->
                <pattern id="neighbor-roof" width="10" height="10" patternUnits="userSpaceOnUse">
                  <path d="M 0 10 L 10 10" stroke="#475569" stroke-width="1" stroke-opacity="0.25"></path>
                </pattern>
              </defs>

              <!-- Rear Property Context Header -->
              <rect x="0" y="0" width="700" height="35" class="fill-slate-200/80 dark:fill-slate-900/90"></rect>
              <text
                x="350"
                y="22"
                text-anchor="middle"
                class="fill-slate-600 dark:fill-slate-400 text-[11px] font-bold tracking-wider uppercase"
              >
                Rear Lot Line (Abutting Backyard Parcels)
              </text>

              <!-- Grass background for all 3 lots -->
              <rect x="50" y="35" width="600" height="500" class="fill-[#dcebd8] dark:fill-[#192a20]"></rect>
              <rect x="50" y="35" width="600" height="500" fill="url(#lot-grid)"></rect>

              <!-- Left & Right Neighbor Lots Tint -->
              <rect x="50" y="35" width="200" height="500" class="fill-slate-900/5 dark:fill-black/25"></rect>
              <rect x="450" y="35" width="200" height="500" class="fill-slate-900/5 dark:fill-black/25"></rect>

              <!-- Center Lot Highlight ("YOUR LOT") -->
              <rect
                id="center-lot-bg"
                x="250"
                y="35"
                width="200"
                height="500"
                class="fill-emerald-50/40 dark:fill-emerald-900/10"></rect>

              <!-- ================= LEFT NEIGHBOR TRIPLE-DECKER (Lot 1: X=50..250) ================= -->
              <g id="left-neighbor-group">
                <text
                  x="150"
                  y="56"
                  text-anchor="middle"
                  class="fill-slate-600 dark:fill-slate-400 text-[11px] font-bold"
                >
                  LOT A: 40&prime; &times; 100&prime; (4,000 sf)
                </text>
                <text x="150" y="71" text-anchor="middle" class="fill-slate-500 dark:fill-slate-400 text-[10px]">
                  Existing 1910 Triple-Decker
                </text>

                <!-- Rear Porch -->
                <rect
                  x="105"
                  y="220"
                  width="110"
                  height="25"
                  rx="2"
                  class="fill-amber-900/20 dark:fill-amber-500/15 stroke-amber-800/50 dark:stroke-amber-400/40"
                  stroke-width="1.5"></rect>
                <!-- Main Building Footprint (28' x 48') -->
                <rect
                  x="90"
                  y="245"
                  width="140"
                  height="240"
                  rx="3"
                  class="fill-amber-100 dark:fill-amber-950/80 stroke-amber-800 dark:stroke-amber-500"
                  stroke-width="2.5"></rect>
                <rect x="90" y="245" width="140" height="240" fill="url(#neighbor-roof)"></rect>
                <!-- Front Bay Window & Porch -->
                <rect
                  x="100"
                  y="485"
                  width="120"
                  height="22"
                  rx="2"
                  class="fill-amber-200/90 dark:fill-amber-900/70 stroke-amber-800 dark:stroke-amber-500"
                  stroke-width="1.5"></rect>
                <!-- Ridge line -->
                <line
                  x1="160"
                  y1="245"
                  x2="160"
                  y2="485"
                  stroke="#92400e"
                  stroke-width="1.5"
                  stroke-dasharray="4 3"
                  opacity="0.5"></line>

                <!-- Labels on Left Triple-Decker -->
                <rect
                  x="100"
                  y="322"
                  width="120"
                  height="78"
                  rx="5"
                  class="fill-white/90 dark:fill-slate-900/90 stroke-amber-700/40"
                  stroke-width="1"></rect>
                <text
                  x="160"
                  y="341"
                  text-anchor="middle"
                  class="fill-slate-800 dark:fill-amber-200 text-[11px] font-extrabold"
                >
                  3-Family Triple-Decker
                </text>
                <text
                  x="160"
                  y="356"
                  text-anchor="middle"
                  class="fill-slate-600 dark:fill-slate-300 text-[10px] font-medium"
                >
                  28&prime; &times; 48&prime; (1,344 sf/fl)
                </text>
                <text
                  x="160"
                  y="371"
                  text-anchor="middle"
                  class="fill-slate-600 dark:fill-slate-300 text-[10px] font-medium"
                >
                  3 Stories &bull; 33 ft &bull; FAR 1.01
                </text>
                <text
                  x="160"
                  y="388"
                  text-anchor="middle"
                  class="fill-rose-700 dark:fill-rose-400 text-[9.5px] font-bold"
                >
                  Built 1910 (Pre-Zoning)
                </text>

                <!-- 4' distance indicator to shared lot line -->
                <line x1="230" y1="365" x2="250" y2="365" stroke="#64748b" stroke-width="1.5"></line>
                <text
                  x="240"
                  y="359"
                  text-anchor="middle"
                  class="fill-slate-600 dark:fill-slate-300 text-[9px] font-bold"
                >
                  4&prime;
                </text>
                <!-- 10' front setback indicator -->
                <line x1="160" y1="485" x2="160" y2="535" stroke="#64748b" stroke-width="1.5" stroke-dasharray="2 2"
                ></line>
                <text x="142" y="523" text-anchor="end" class="fill-slate-600 dark:fill-slate-300 text-[9px] font-bold">
                  10&prime; front
                </text>
              </g>

              <!-- ================= RIGHT NEIGHBOR TRIPLE-DECKER (Lot 3: X=450..650) ================= -->
              <g id="right-neighbor-group">
                <text
                  x="550"
                  y="56"
                  text-anchor="middle"
                  class="fill-slate-600 dark:fill-slate-400 text-[11px] font-bold"
                >
                  LOT C: 40&prime; &times; 100&prime; (4,000 sf)
                </text>
                <text x="550" y="71" text-anchor="middle" class="fill-slate-500 dark:fill-slate-400 text-[10px]">
                  Existing 1910 Triple-Decker
                </text>

                <!-- Rear Porch -->
                <rect
                  x="485"
                  y="220"
                  width="110"
                  height="25"
                  rx="2"
                  class="fill-amber-900/20 dark:fill-amber-500/15 stroke-amber-800/50 dark:stroke-amber-400/40"
                  stroke-width="1.5"></rect>
                <!-- Main Building Footprint (28' x 48') -->
                <rect
                  x="470"
                  y="245"
                  width="140"
                  height="240"
                  rx="3"
                  class="fill-amber-100 dark:fill-amber-950/80 stroke-amber-800 dark:stroke-amber-500"
                  stroke-width="2.5"></rect>
                <rect x="470" y="245" width="140" height="240" fill="url(#neighbor-roof)"></rect>
                <!-- Front Porch -->
                <rect
                  x="480"
                  y="485"
                  width="120"
                  height="22"
                  rx="2"
                  class="fill-amber-200/90 dark:fill-amber-900/70 stroke-amber-800 dark:stroke-amber-500"
                  stroke-width="1.5"></rect>
                <line
                  x1="540"
                  y1="245"
                  x2="540"
                  y2="485"
                  stroke="#92400e"
                  stroke-width="1.5"
                  stroke-dasharray="4 3"
                  opacity="0.5"></line>

                <!-- Labels on Right Triple-Decker -->
                <rect
                  x="480"
                  y="322"
                  width="120"
                  height="78"
                  rx="5"
                  class="fill-white/90 dark:fill-slate-900/90 stroke-amber-700/40"
                  stroke-width="1"></rect>
                <text
                  x="540"
                  y="341"
                  text-anchor="middle"
                  class="fill-slate-800 dark:fill-amber-200 text-[11px] font-extrabold"
                >
                  3-Family Triple-Decker
                </text>
                <text
                  x="540"
                  y="356"
                  text-anchor="middle"
                  class="fill-slate-600 dark:fill-slate-300 text-[10px] font-medium"
                >
                  28&prime; &times; 48&prime; (1,344 sf/fl)
                </text>
                <text
                  x="540"
                  y="371"
                  text-anchor="middle"
                  class="fill-slate-600 dark:fill-slate-300 text-[10px] font-medium"
                >
                  3 Stories &bull; 33 ft &bull; FAR 1.01
                </text>
                <text
                  x="540"
                  y="388"
                  text-anchor="middle"
                  class="fill-rose-700 dark:fill-rose-400 text-[9.5px] font-bold"
                >
                  Built 1910 (Pre-Zoning)
                </text>

                <!-- 4' distance indicator to shared lot line -->
                <line x1="450" y1="365" x2="470" y2="365" stroke="#64748b" stroke-width="1.5"></line>
                <text
                  x="460"
                  y="359"
                  text-anchor="middle"
                  class="fill-slate-600 dark:fill-slate-300 text-[9px] font-bold"
                >
                  4&prime;
                </text>
                <!-- 10' front setback indicator -->
                <line x1="540" y1="485" x2="540" y2="535" stroke="#64748b" stroke-width="1.5" stroke-dasharray="2 2"
                ></line>
                <text
                  x="558"
                  y="523"
                  text-anchor="start"
                  class="fill-slate-600 dark:fill-slate-300 text-[9px] font-bold"
                >
                  10&prime; front
                </text>
              </g>

              <!-- ================= CENTER LOT SETBACK GUIDES OVERLAY (Hidden by default) ================= -->
              <g id="setback-guides-layer" class="hidden">
                <!-- Forbidden Setback Hatch around perimeter of Center Lot -->
                <rect x="250" y="35" width="200" height="150" fill="url(#setback-hatch)"></rect>
                <rect x="250" y="435" width="200" height="100" fill="url(#setback-hatch)"></rect>
                <rect x="250" y="185" width="30" height="250" fill="url(#setback-hatch)"></rect>
                <rect x="420" y="185" width="30" height="250" fill="url(#setback-hatch)"></rect>

                <!-- Legal Setback Envelope Box -->
                <rect
                  x="280"
                  y="185"
                  width="140"
                  height="250"
                  fill="none"
                  stroke="#0ea5e9"
                  stroke-width="2"
                  stroke-dasharray="6 4"></rect>

                <!-- Setback Guide Labels -->
                <text
                  x="350"
                  y="178"
                  text-anchor="middle"
                  class="fill-rose-700 dark:fill-rose-300 text-[9.5px] font-bold"
                >
                  &uarr; 30&prime; Min Rear Yard Setback &uarr;
                </text>
                <text
                  x="350"
                  y="450"
                  text-anchor="middle"
                  class="fill-rose-700 dark:fill-rose-300 text-[9.5px] font-bold"
                >
                  &darr; 20&prime; Min Front Yard Setback &darr;
                </text>
                <text x="350" y="200" text-anchor="middle" class="fill-sky-800 dark:fill-sky-300 text-[9px] font-bold">
                  Max Setback Envelope (Max 25&prime; W w/ 15&prime; Side Yards &times; 50&prime; D)
                </text>
              </g>

              <!-- Center Lot Header Title -->
              <text
                x="350"
                y="56"
                text-anchor="middle"
                class="fill-emerald-950 dark:fill-emerald-200 text-[11.5px] font-extrabold"
              >
                YOUR LOT: 40&prime; &times; 100&prime; (4,000 sf)
              </text>
              <text
                x="350"
                y="71"
                text-anchor="middle"
                class="fill-emerald-800 dark:fill-emerald-300 text-[10px] font-semibold"
              >
                Click &amp; Drag to Draw Building
              </text>

              <!-- Optional Rear Yard 2-Car Garage -->
              <g id="garage-group" class="hidden">
                <rect
                  x="335"
                  y="50"
                  width="100"
                  height="100"
                  rx="2"
                  class="fill-rose-200/90 dark:fill-rose-900/70 stroke-rose-600 dark:stroke-rose-400"
                  stroke-width="2"></rect>
                <text
                  x="385"
                  y="95"
                  text-anchor="middle"
                  class="fill-rose-950 dark:fill-rose-100 text-[10px] font-extrabold"
                >
                  2-Car Garage
                </text>
                <text
                  x="385"
                  y="109"
                  text-anchor="middle"
                  class="fill-rose-900 dark:fill-rose-200 text-[9px] font-bold"
                >
                  20&prime;&times;20&prime; (400 sf)
                </text>
                <text
                  x="385"
                  y="123"
                  text-anchor="middle"
                  class="fill-rose-800 dark:fill-rose-300 text-[8.5px] font-bold"
                >
                  33% of Rear Yard (&gt;25%!)
                </text>
              </g>

              <!-- Lot Boundary Lines -->
              <rect x="50" y="35" width="600" height="500" fill="none" stroke="#334155" stroke-width="2"></rect>
              <line x1="250" y1="35" x2="250" y2="535" stroke="#1e293b" stroke-width="2.5" stroke-dasharray="7 4"
              ></line>
              <line x1="450" y1="35" x2="450" y2="535" stroke="#1e293b" stroke-width="2.5" stroke-dasharray="7 4"
              ></line>

              <!-- Lot Depth Label (100' on left side) -->
              <g>
                <line x1="28" y1="35" x2="28" y2="535" stroke="#64748b" stroke-width="1.5"></line>
                <line x1="22" y1="35" x2="34" y2="35" stroke="#64748b" stroke-width="1.5"></line>
                <line x1="22" y1="535" x2="34" y2="535" stroke="#64748b" stroke-width="1.5"></line>
                <text
                  x="18"
                  y="285"
                  text-anchor="middle"
                  transform="rotate(-90 18 285)"
                  class="fill-slate-600 dark:fill-slate-400 text-[10.5px] font-bold"
                >
                  100 ft Lot Depth
                </text>
              </g>

              <!-- ================= USER'S DRAWN BUILDING FOOTPRINT & LIVE DIMENSION ARROWS ================= -->
              <g id="user-building-layer" class="hidden">
                <!-- Dynamic Setback Dimension Lines (populated/updated via JS) -->
                <g id="live-dimensions-group"></g>

                <!-- User's Building Box -->
                <rect
                  id="user-building-rect"
                  x="280"
                  y="245"
                  width="140"
                  height="240"
                  rx="3"
                  class="fill-indigo-500/80 stroke-indigo-900 dark:stroke-white cursor-move"
                  stroke-width="2.5"></rect>

                <!-- Story Stack Visual Effect (subtle inner offset lines for stories 2 & 3+) -->
                <rect
                  id="user-story-ring-2"
                  x="284"
                  y="249"
                  width="132"
                  height="232"
                  fill="none"
                  stroke="white"
                  stroke-opacity="0.45"
                  stroke-width="1.5"
                  pointer-events="none"></rect>
                <rect
                  id="user-story-ring-3"
                  x="288"
                  y="253"
                  width="124"
                  height="224"
                  fill="none"
                  stroke="white"
                  stroke-opacity="0.45"
                  stroke-width="1.5"
                  pointer-events="none"></rect>

                <!-- Building Center Info Label -->
                <g id="user-building-label" pointer-events="none">
                  <rect id="user-label-bg" x="292" y="330" width="116" height="66" rx="5" class="fill-slate-900/85"
                  ></rect>
                  <text
                    id="user-label-title"
                    x="350"
                    y="348"
                    text-anchor="middle"
                    class="fill-white text-[11px] font-extrabold"
                  >
                    28&prime; &times; 48&prime;
                  </text>
                  <text
                    id="user-label-area"
                    x="350"
                    y="364"
                    text-anchor="middle"
                    class="fill-indigo-200 text-[10px] font-semibold"
                  >
                    1,344 sq. ft. / floor
                  </text>
                  <text
                    id="user-label-stories"
                    x="350"
                    y="379"
                    text-anchor="middle"
                    class="fill-amber-300 text-[10px] font-bold"
                  >
                    3 Stories (4,032 sf)
                  </text>
                  <text
                    id="user-label-far"
                    x="350"
                    y="392"
                    text-anchor="middle"
                    class="fill-white/90 text-[9px] font-medium"
                  >
                    FAR: 1.01
                  </text>
                </g>

                <!-- 8 Resize Handles (N, S, W, E, NW, NE, SW, SE) -->
                <g id="resize-handles-group">
                  <rect
                    data-handle="n"
                    x="340"
                    y="240"
                    width="20"
                    height="10"
                    rx="2"
                    class="fill-white stroke-slate-900 cursor-ns-resize"
                    stroke-width="1.5"></rect>
                  <rect
                    data-handle="s"
                    x="340"
                    y="480"
                    width="20"
                    height="10"
                    rx="2"
                    class="fill-white stroke-slate-900 cursor-ns-resize"
                    stroke-width="1.5"></rect>
                  <rect
                    data-handle="w"
                    x="275"
                    y="355"
                    width="10"
                    height="20"
                    rx="2"
                    class="fill-white stroke-slate-900 cursor-ew-resize"
                    stroke-width="1.5"></rect>
                  <rect
                    data-handle="e"
                    x="415"
                    y="355"
                    width="10"
                    height="20"
                    rx="2"
                    class="fill-white stroke-slate-900 cursor-ew-resize"
                    stroke-width="1.5"></rect>

                  <circle
                    data-handle="nw"
                    cx="280"
                    cy="245"
                    r="6"
                    class="fill-white stroke-slate-900 cursor-nwse-resize"
                    stroke-width="2"></circle>
                  <circle
                    data-handle="ne"
                    cx="420"
                    cy="245"
                    r="6"
                    class="fill-white stroke-slate-900 cursor-nesw-resize"
                    stroke-width="2"></circle>
                  <circle
                    data-handle="sw"
                    cx="280"
                    cy="485"
                    r="6"
                    class="fill-white stroke-slate-900 cursor-nesw-resize"
                    stroke-width="2"></circle>
                  <circle
                    data-handle="se"
                    cx="420"
                    cy="485"
                    r="6"
                    class="fill-white stroke-slate-900 cursor-nwse-resize"
                    stroke-width="2"></circle>
                </g>
              </g>

              <!-- ================= SIDEWALK & STREET AT BOTTOM (Y=535..615) ================= -->
              <!-- Concrete Sidewalk (Y=535..562) -->
              <rect x="0" y="535" width="700" height="27" class="fill-slate-300 dark:fill-slate-700"></rect>
              <line x1="0" y1="535" x2="700" y2="535" stroke="#0f172a" stroke-width="2.5"></line>
              <line x1="0" y1="562" x2="700" y2="562" stroke="#64748b" stroke-width="1.5"></line>

              <!-- Street Asphalt (Y=562..615) -->
              <rect x="0" y="562" width="700" height="53" class="fill-slate-700 dark:fill-slate-900"></rect>
              <line
                x1="30"
                y1="589"
                x2="670"
                y2="589"
                stroke="#facc15"
                stroke-width="2"
                stroke-dasharray="18 14"
                opacity="0.85"></line>
              <text
                x="350"
                y="606"
                text-anchor="middle"
                class="fill-slate-200 text-[11px] font-bold tracking-widest uppercase"
              >
                Allston-Brighton Residential Street
              </text>
            </svg>
          </div>

          <div
            class="mt-2.5 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-600 dark:text-slate-400 px-1"
          >
            <span>
              <strong>Tip:</strong> Drag on the empty lot to draw a building box, drag inside to move it, or drag the white
              handles to resize.
            </span>
            <span class="font-mono">Scale: 1 grid square = 5&prime; &times; 5&prime; (25 sq. ft.)</span>
          </div>
        </div>
      </div>

      <!-- Bottom Card: Live Streetscape Front Elevation (Visualizing Stories & Height) -->
      <div
